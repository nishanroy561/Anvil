{
  "title": "Anvil Ingestion",
  "uid": "anvil-ingestion",
  "schemaVersion": 39,
  "refresh": "10s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Stream depth vs high-water",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "targets": [{ "expr": "anvil_stream_depth", "legendFormat": "stream depth" }]
    },
    {
      "id": 2,
      "title": "Accepted traces /s",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "targets": [{ "expr": "sum(rate(anvil_ingest_traces_accepted_total[1m]))", "legendFormat": "accepted/s" }]
    },
    {
      "id": 3,
      "title": "Rejections by cause /s",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 },
      "targets": [{ "expr": "sum by (cause) (rate(anvil_ingest_rejected_total[1m]))", "legendFormat": "{{cause}}" }]
    },
    {
      "id": 4,
      "title": "Consumer lag / DLQ depth",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 8, "w": 12, "h": 8 },
      "targets": [
        { "expr": "anvil_consumer_lag", "legendFormat": "consumer lag" },
        { "expr": "anvil_dlq_depth", "legendFormat": "dlq depth" }
      ]
    }
  ]
}
