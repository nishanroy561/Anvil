# ── Core ────────────────────────────────────────────────────────────────
# Async SQLAlchemy URL (asyncpg driver). Compose overrides host to `postgres`.
DATABASE_URL=postgresql+asyncpg://anvil:anvil@localhost:5432/anvil
REDIS_URL=redis://localhost:6379/0
# Signs session cookies. Change in any real deployment.
SECRET_KEY=dev-secret-change-me

# ── Deployment shape (plan/adr/0019, plan/plugins.md §3) ────────────────
# Anvil is fully open source: every install has every feature, and there are
# no plans, quotas or gates. This flag only controls plugin loading.
# self_hosted (default): third-party graders/alert channels/pricing resolvers
#   load from entry points.
# cloud: a shared, multi-tenant deployment — built-in plugins only, because
#   arbitrary third-party Python must not run next to other people's data.
DEPLOYMENT_MODE=self_hosted

# ── LLM judge/target keys (Phase 5; optional until then) ────────────────
# The *model name* picks the provider (ADR-0016) — set the key for whichever
# you name in the grader or target config:
#   claude-*                       -> ANTHROPIC_API_KEY
#   gemini-*                       -> GOOGLE_API_KEY
#   groq/<groq model id>           -> GROQ_API_KEY   (ADR-0020)
# Groq needs the explicit `groq/` prefix because it hosts models rather than
# making them, and a bare `openai/gpt-oss-120b` would say the wrong thing about
# who is serving it. Example: groq/llama-3.3-70b-versatile
#
# **Name the model explicitly.** With no model named the first key present wins,
# in the fixed order below — so a stale ANTHROPIC_API_KEY silently captures
# every judge call on a box that also has Google and Groq keys.
# Needs `pip install -e .[judges]` in apps/worker for the provider packages.
ANTHROPIC_API_KEY=
# aistudio.google.com/apikey — free tier, no card required.
GOOGLE_API_KEY=
# console.groq.com/keys — free tier with generous rate limits.
GROQ_API_KEY=

# ── Web ─────────────────────────────────────────────────────────────────
# Origin the API allows via CORS; the browser-facing dashboard URL. Same in both
# setups, because it is where the *browser* is.
WEB_ORIGIN=http://localhost:3000

# Where the web *server* reaches the API — not the browser, which always goes
# through the same-origin /api rewrite so the session cookie stays first-party.
#
# **Leave this unset.** The two correct values differ by setup and both are already
# defaults: compose uses `http://api:8000` (service name on the compose network)
# and `npm run dev` uses `http://localhost:8000`. Setting it to either one breaks
# the other — a `.env` carrying `localhost:8000` made the dashboard in compose
# return 500 on every request, because inside that container localhost is the
# container. Only set it if the API lives somewhere neither default describes.
# WEB_API_BASE_URL=

# ── Rate limits (ADR-0007) ──────────────────────────────────────────────
# Fixed-window, per minute, and **fail-open**: if Redis is unreachable the
# request is allowed. A rate limiter must never become the outage.
#
# Every externally reachable surface has one. The audit, for anyone adding a
# route — if a new surface appears below without a limit, that is the bug:
#   auth login/signup   AUTH_IP_LIMIT_PM + AUTH_EMAIL_LIMIT_PM  (per IP, per email)
#   ingest              INGEST_RATE_LIMIT_RPM + …_TRACES_PM     (per API key)
#   feedback            FEEDBACK_RATE_LIMIT_PM                  (per API key)
#   dashboard reads     SESSION_READ_LIMIT_PM                   (per session)
#   eval runs           MAX_EVAL_ITEMS + MAX_CONCURRENT_RUNS    (spend, not rate)
#
# Brute force and credential stuffing (checklist row 17). Two limits, because
# per-IP alone is defeated by rotating addresses and per-email alone by spraying
# one password across many accounts.
AUTH_IP_LIMIT_PM=10
AUTH_EMAIL_LIMIT_PM=5
# Backstop on dashboard reads, per signed-in session. Far above human use — this
# catches a page stuck in a refresh loop, not a person clicking. 0 disables it.
# Writes are not metered: a limiter must not be why a form submission fails.
SESSION_READ_LIMIT_PM=240

# ── Ingestion (Phase 2) ─────────────────────────────────────────────────
INGEST_HIGH_WATER=80000
# Per API key: requests/min, and *traces*/min counted separately so one 500-trace
# batch costs 500 (checklist row 16 — a noisy tenant must not starve the others).
INGEST_RATE_LIMIT_RPM=300
INGEST_RATE_LIMIT_TRACES_PM=5000

# ── Judge tracing / dogfooding (Phase 5; optional) ──────────────────────
# Set to an Anvil API key and every LLM judge call is traced into that key's
# project — Anvil observing its own judges. Unset = off, costs nothing.
# Use a project created for this; judge traces arrive through normal ingest,
# so pointing it at a project under evaluation mixes them into the data being
# measured. Needs the SDK: pip install -e sdks/python
ANVIL_INTERNAL_API_KEY=
ANVIL_INTERNAL_BASE_URL=http://localhost:8000

# ── Eval spend guards (Phase 5) ─────────────────────────────────────────
MAX_EVAL_ITEMS=500
MAX_CONCURRENT_RUNS=3

# ── Feedback loop (Phase 9) ─────────────────────────────────────────────
# POST /v1/feedback is reachable from a customer's own end users, so it is the
# most abuse-exposed surface after ingest. Per API key, per minute.
FEEDBACK_RATE_LIMIT_PM=600
FEEDBACK_MAX_COMMENT_CHARS=4000
# A thumbs-down can beat its trace to the database. The worker holds such rows
# and retries with a widening delay; after the window they go to the DLQ rather
# than retrying forever. FEEDBACK_DEFERRED_MAX caps that retry set, because
# feedback naming trace ids that will never exist is the abuse shape here.
FEEDBACK_RETRY_WINDOW_S=600
FEEDBACK_RETRY_MAX_DELAY_S=30
FEEDBACK_DEFERRED_MAX=50000

# ── Retention (Phase 10) ────────────────────────────────────────────────
# **Unset means keep everything**, and that is the default: an operator who has
# not asked for deletion never gets deletion. Set a number of days to have the
# worker delete traces older than that, once a day, in batches.
#
# Spans, feedback and monitor scores go with the trace. Datasets do NOT — a
# promoted item keeps its own copy of the input and outputs, so curated test
# cases outlive the traffic they came from (checklist row 24).
#
# Usage rollups run daily either way, and only ever count up: deleting traces
# never rewrites the month they were ingested in (ADR-0022).
RETENTION_DAYS=
# Traces per transaction, and the pause between batches. One giant DELETE would
# bloat the WAL and hold locks for the whole sweep (checklist row 23).
RETENTION_BATCH_SIZE=5000
RETENTION_BATCH_SLEEP_S=0.5

# ── Self-observability (plan/observability.md) ──────────────────────────
# Anvil tracing Anvil. Unset = off, and that is the default: instrumentation costs
# latency on every request and an install without a collector has nowhere to send
# spans. Set it and one ingest becomes a single trace across API → worker →
# Postgres, viewable in Grafana's Tempo datasource.
#
#   docker compose --profile observability up -d
#   OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
#
# The images need building with the [otel] extra, which compose does by default.
OTEL_EXPORTER_OTLP_ENDPOINT=

# ── Cloud admin (vestigial; no hosted tier — ADR-0019) ──────────────────
ADMIN_API_KEY=

# ── Less common knobs ───────────────────────────────────────────────────
# Everything above is what people actually change. These are the rest of the
# settings an operator might plausibly reach for; all are optional and the
# defaults shown are the real ones.
#
# **This file is not the exhaustive list.** Queue and consumer internals
# (batch sizes, block times, reclaim intervals, heartbeats) are deliberately
# left out — documenting all of them would turn a getting-started file into a
# reference nobody reads. The complete set, with a comment on each, lives in
# `apps/api/anvil_api/config.py` and `apps/worker/anvil_worker/config.py`.

# How long a dashboard login lasts. 7 days.
# SESSION_MAX_AGE_S=604800

# Payload caps. A request over the body cap is rejected with 413; a single field
# over the field cap is truncated in place with a marker rather than dropping the
# trace (checklist row 6).
# INGEST_MAX_BODY_BYTES=5242880
# INGEST_MAX_FIELD_BYTES=102400

# Free-text search fences. Trigram indexes degrade on very short needles, and an
# unbounded time range turns one search into a full-history scan (checklist row 26).
# SEARCH_MIN_CHARS=3
# SEARCH_DEFAULT_DAYS=7
# SEARCH_MAX_DAYS=30

# Pagination ceilings, so one request cannot ask for the whole table.
# TRACES_PAGE_SIZE_MAX=200
# FAILURE_INBOX_PAGE_SIZE_MAX=200

# Grader budgets (plan/plugins.md §3). A string comparison and a model round trip
# are not the same workload, so judges get their own — 30 s timed out roughly a
# third of real judge calls in testing, which reads as "the judge is flaky" rather
# than "our budget was wrong".
# GRADER_TIMEOUT_S=30
# JUDGE_TIMEOUT_S=120

# Where the worker serves Prometheus metrics.
# METRICS_PORT=9101
