{
  "name": "@anvil/sdk",
  "version": "0.1.0",
  "description": "Anvil TypeScript SDK — trace instrumentation for LLM apps",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
